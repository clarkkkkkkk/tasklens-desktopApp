{
  "name": "tasklens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native:win": "node scripts/windows-native-acceptance.mjs",
    "test:native:ai": "node scripts/windows-local-ai-acceptance.mjs",
    "tauri": "tauri",
    "format": "prettier --write src tests scripts *.ts *.js *.json",
    "format:check": "prettier --check src tests scripts *.ts *.js *.json",
    "build:runtimes": "node scripts/build-local-runtimes.mjs",
    "prepare:models": "node scripts/prepare-models.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "release:desktop": "node scripts/release-desktop.mjs",
    "test:assets": "node --test scripts/ai-assets.test.mjs",
    "prepare:notices": "node scripts/collect-ai-notices.mjs",
    "prepare:packaging": "node scripts/prepare-packaging-tools.mjs",
    "test:native:ocr": "node scripts/ocr-smoke.mjs",
    "test:native:groq:credentials": "node scripts/groq-credential-acceptance.mjs",
    "test:native:groq": "node scripts/groq-native-acceptance.mjs",
    "eval:groq": "node scripts/evaluate-groq.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@solar-icons/react": "^2.3.2",
    "@tauri-apps/api": "^2.12.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "3.8.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.1.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
